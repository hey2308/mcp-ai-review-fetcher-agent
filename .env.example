# Copy this file to .env and fill in values:
#   copy .env.example .env
#
# Env vars override config.yaml when set.

# Required for live runs (Phase 2)
GROQ_API_KEY=your_groq_api_key_here

# Optional — override config.yaml publish settings
MCP_SERVER_URL=https://xyz.com
EMAIL_ALIAS=your-email@example.com
GOOGLE_DOC_ID=your_google_doc_id_here
